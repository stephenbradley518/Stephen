# Betfair Exchange API credentials — copy to .env and fill in, never commit
# the real values. Get an App Key at https://developer.betfair.com/.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Optional: certificate login (recommended by Betfair for bots). If set,
# these take priority over the interactive username/password login.
BETFAIR_CERT_FILE=
BETFAIR_CERT_KEY=

# Optional overrides (defaults shown)
# MODEL_DIR=betting_predictor/models
# N_OUTCOMES=3
# VALUE_EDGE_THRESHOLD=0.02
